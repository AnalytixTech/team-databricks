{
  "name": "fleetly-backend",
  "version": "2.0.0",
  "description": "Fleetly Car Rental Platform - Enterprise-grade backend with Paystack subaccounts, driver ratings, smart recommendations, real-time chat, and map integration. Built with TypeScript, Express, MongoDB.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "pm2:start": "pm2 start dist/server.js --name fleetly-backend",
    "pm2:stop": "pm2 stop fleetly-backend",
    "pm2:restart": "pm2 restart fleetly-backend",
    "pm2:delete": "pm2 delete fleetly-backend",
    "pm2:logs": "pm2 logs fleetly-backend",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "car-rental",
    "fleet-management",
    "express",
    "typescript",
    "mongodb",
    "paystack",
    "oauth",
    "revenue-sharing",
    "ratings",
    "recommendations",
    "socketio",
    "realtime-chat",
    "openstreetmap",
    "geocoding"
  ],
  "author": "Fleetly Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "@sendgrid/mail": "^8.1.0",
    "cloudinary": "^1.41.0",
    "multer": "^1.4.5-lts.1",
    "paystack": "^2.0.1",
    "express-validator": "^7.0.1",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "node-cron": "^3.0.3",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/passport-jwt": "^4.0.0",
    "@types/multer": "^1.4.11",
    "@types/paystack": "^2.0.4",
    "@types/cors": "^2.8.17",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2",
    "@types/express-validator": "^3.0.0"
  },
  "type": "commonjs"
}
