# Flask Configuration
FLASK_ENV=development
JWT_SECRET_KEY=your-jwt-secret-key-here

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=car_rental_db

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@carrental.com

# Paystack Configuration
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret

# Oracle Cloud Infrastructure (OCI) Authentication
# Get these from your OCI Console -> User Settings -> API Keys
OCI_CLI_USER=ocid1.user.oc1..aaaaaaaa...
OCI_CLI_TENANCY=ocid1.tenancy.oc1..aaaaaaaa...
OCI_CLI_FINGERPRINT=aa:bb:cc:dd:ee:ff:gg:hh:ii:jj:kk:ll:mm:nn:oo:pp
OCI_CLI_KEY_FILE=/path/to/your/private-key.pem
OCI_CLI_REGION=us-ashburn-1

# Oracle Object Storage Configuration
OCI_NAMESPACE=your-tenancy-namespace
OCI_BUCKET_NAME=your-bucket-name

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080